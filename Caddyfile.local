{
    admin off
    auto_https off
}

:8080 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Robots-Tag "noindex, nofollow"
        Cache-Control no-store
    }
    handle /healthz {
        respond "ok" 200
    }
    handle /version.json {
        root * /opt
        rewrite * /site-version.json
        file_server
    }
    handle /api/public/* {
        reverse_proxy booking:8081
    }
    handle /api/* {
        respond "Not found" 404
    }
    handle /oauth/* {
        respond "Not found" 404
    }
    handle {
        root * /srv
        file_server
    }
}
