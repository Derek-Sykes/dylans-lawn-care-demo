# Optional overrides only. The launcher creates .local/runtime.env automatically.
# Each clone gets a unique project/database and remembers available loopback ports.
# DYLAN_PORT=4177
# DYLAN_ADMIN_PORT=4178
# DYLAN_PROJECT=dylan-my-explicit-install
# GOOGLE_CLIENT_ID=public-desktop-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_MODE=desktop
# Web OAuth is for a separately configured HTTPS deployment, not local startup.
# Never commit bootstrap tokens, OAuth secrets, database files or encryption keys.
# Local launchers import the approved operator identity from private dev configuration.
# Future hosted setups can provision OPERATOR_GOOGLE_SUB and OPERATOR_GOOGLE_EMAIL
# privately in the server environment. These identify who may sign in; they are
# not Google passwords or Calendar tokens.
